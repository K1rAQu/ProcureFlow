# Database configuration
# Embedded local SQLite file (auto-initialized) or remote Turso LibSQL URL (libsql://...)
DATABASE_URL=file:./data/procurement.db
DATABASE_AUTH_TOKEN=

# Default interface language: "en" (English) or "uk" (Ukrainian)
DEFAULT_LOCALE=en

# Real-time updates via Server-Sent Events (SSE): "true" or "false"
ENABLE_REALTIME=true

# Public demo mode: set "true" to limit backups (max 2 files, 60s cooldown) to protect storage
DEMO_MODE=false

# Allow creating database backups via Admin Maintenance panel ("true" or "false")
ALLOW_DATABASE_BACKUPS=true

# Maximum retained backup files on server (older snapshots are auto-pruned; default 10, demo 2)
MAX_BACKUPS_COUNT=10

# Directory for secure storage of uploaded photos and attachments
UPLOAD_DIR=./var/uploads

# Base application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================================
# Google OAuth 2.0 Authentication
# ========================================================
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict user registration and login to a specific corporate email domain
# Example: company.com (without '@'). Leave blank to allow any Google account.
# This variable is server-only and is never exposed to client browsers.
CORPORATE_EMAIL_DOMAIN=

# ========================================================
# Security, Geoblocking & VPN Filter
# ========================================================
# Access restriction mode:
# - "off"        : Geoblocking disabled (default for local development)
# - "cloudflare" : Uses validated Cloudflare headers (CF-IPCountry, CF-Threat-Score)
# - "nginx"      : Uses reverse proxy GeoIP2 headers (X-Country-Code)
# - "standalone" : Standalone IP lookup without Cloudflare or Nginx
GEO_RESTRICT_MODE=off

# Allowed ISO country codes (comma-separated, e.g. UA,US,PL,DE,GB)
ALLOWED_COUNTRIES=UA,US,PL,DE,GB

# Block anonymous VPNs, Tor exit nodes, and hosting proxies ("true" | "false")
BLOCK_VPN=false

# ========================================================
# Outgoing Email Notifications (SMTP)
# ========================================================
# Leave SMTP_HOST blank to log outgoing emails directly to the server console
#
# Example configuration for Gmail / Google Workspace:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=procurement@company.com
# SMTP_PASS=abcd efgh ijkl mnop   # 16-character Google App Password
# SMTP_FROM=Procurement System <procurement@company.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Procurement System <noreply@procurement.local>
