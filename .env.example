# База даних (SQLite файл, створюється автоматично; або Turso URL libsql://...)
DATABASE_URL=file:./data/procurement.db
DATABASE_AUTH_TOKEN=

# Мова за замовчуванням: "en" (англійська) або "uk" (українська)
DEFAULT_LOCALE=en

# Real-time оновлення через Server-Sent Events (SSE): "true" або "false"
ENABLE_REALTIME=true

# Публічний демо-режим: "true" обмежує створення бекапів (макс 2 копії, кулдаун 60с) для захисту від флуду диска
DEMO_MODE=false

# Дозволити створення резервних копій бази через адмінку ("true" або "false")
ALLOW_DATABASE_BACKUPS=true

# Максимальна кількість збережених копій на сервері (старі авто-видаляються; за замовчуванням 10, для демо 2)
MAX_BACKUPS_COUNT=10

# Директорія для захищеного зберігання фотографій і вкладень
UPLOAD_DIR=./var/uploads

# Базовий URL додатку
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================================
# Авторизація через Google OAuth 2.0
# ========================================================
# Отримайте у Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Обмеження реєстрації та входу виключно за єдиним корпоративним доменом пошти
# Приклад: company.ua (без символу @). Залиште порожнім, якщо обмеження не потрібне.
# Змінна зберігається лише на сервері і ніколи не розкривається у клієнтському коді.
CORPORATE_EMAIL_DOMAIN=

# ========================================================
# Безпека, Геоблокування та VPN
# ========================================================
# Режим обмеження доступу:
# - "off"        : перевірка вимкнена (за замовчуванням для локальної розробки)
# - "cloudflare" : використання перевірених заголовків Cloudflare (CF-IPCountry, CF-Threat-Score)
# - "nginx"      : використання заголовків Nginx з модулем GeoIP2 (X-Country-Code)
# - "standalone" : пряма автономна перевірка IP без Cloudflare чи Nginx
GEO_RESTRICT_MODE=off

# Дозволені країни (коди ISO через кому, за замовчуванням лише Україна)
ALLOWED_COUNTRIES=UA

# Блокувати анонімні VPN, Tor та проксі-сервери ("true" | "false")
BLOCK_VPN=false

# ========================================================
# Поштові сповіщення (SMTP)
# ========================================================
# Залиште SMTP_HOST порожнім, щоб логи листів виводилися у консоль сервера
# 
# Приклад налаштування для Gmail / Google Workspace:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=procurement@company.ua
# SMTP_PASS=abcd efgh ijkl mnop   # 16-значний «Пароль додатка» (App Password) з акаунта Google
# SMTP_FROM=Система закупівель <procurement@company.ua>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Система закупівель <noreply@procurement.local>
